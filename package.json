{
  "name": "nodejs-backend",
  "version": "1.0.0",
  "description": "A Node.js backend project",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "axios": "^1.15.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^4.22.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "nodemon": "^2.0.22"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/services/**/*.js",
      "src/middleware/**/*.js",
      "!src/middleware/auth.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "html",
      "lcov"
    ],
    "coverageDirectory": "coverage"
  }
}
